{
  "version": 2,
  "builds": [
    {
      "src": "SkyAnalytics/api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "runtime": "python3.11"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "SkyAnalytics/api/index.py"
    }
  ],
  "env": {
    "SECRET_KEY": "@SECRET_KEY",
    "DATABASE_URL": "@DATABASE_URL",
    "JWT_ALGORITHM": "HS256",
    "CORS_ORIGINS": "*"
  }
}
