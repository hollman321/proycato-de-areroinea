# Copiar a `.env` en esta carpeta (SkyAnalytics/) antes de `docker-compose up`.

# --- Backend / Dashboard ---
# Configuración de Base de Datos (Docker)
DATABASE_URL=sqlite:///skyanalytics_dev.db
API_BASE_URL=http://backend:8000
POSTGRES_USER=admin
POSTGRES_PASSWORD=secretpassword
POSTGRES_DB=skyanalytics

# JWT y CORS (producción: origen explícito, nunca "*" con cookies sensibles)
SECRET_KEY=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ACCESS_TOKEN_REMEMBER_DAYS=7
CORS_ORIGINS=*
# Seguridad y Autenticación
JWT_ACCESS_SECRET=una_clave_secreta_muy_larga_y_segura_123
JWT_REFRESH_SECRET=otra_clave_secreta_muy_larga_y_segura_456
ALGORITHM=HS256

# Logging
LOG_LEVEL=INFO
# URLs de servicios
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Serverless (Vercel) — el backend usa pool distinto si VERCEL=1
# VERCEL=0

# --- Tests opcionales ---
# TEST_DATABASE_URL=postgresql://admin:secretpassword@db:5432/skyanalytics_test
# Configuración de entorno
NODE_ENV=development
